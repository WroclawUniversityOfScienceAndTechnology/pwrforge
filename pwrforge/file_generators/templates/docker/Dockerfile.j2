ARG DOCKER_IMAGE_ROOT=ubuntu:24.04
FROM ${DOCKER_IMAGE_ROOT} AS base

ENV DEBIAN_FRONTEND noninteractive

RUN apt update --fix-missing && \
    apt -y install --no-install-recommends python3 python3-pip python3-venv\
    git build-essential pkg-config graphviz && \
    apt -y install sudo && \
    rm -rf /var/lib/apt/lists/* && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3 1

FROM base AS cpp
{% set previous_base = 'cpp' %}

RUN apt update --fix-missing && apt -y --no-install-recommends install cppcheck lib32z1 \
    make cmake clang clang-format clang-tidy doxygen libcmocka0 libcmocka-dev gdb screen wget curl && \
    rm -rf /var/lib/apt/lists/*

{% if project.is_esp32() %}
FROM {{ previous_base }} AS esp32
{% set previous_base = 'esp32' %}
{% include 'docker/Dockerfile-esp32.j2' %}
{% endif %}

{% if project.is_stm32() %}
FROM {{ previous_base }} AS stm32
{% set previous_base = 'stm32' %}
{% include 'docker/Dockerfile-arm.j2' %}
{% elif project.is_atsam() %}
FROM {{ previous_base }} AS atsam
{% set previous_base = 'atsam' %}
{% include 'docker/Dockerfile-arm.j2' %}
{% endif %}

WORKDIR /opt

FROM {{ previous_base }} AS custom_{{ project.name }}
{{ custom_docker }}
FROM custom_{{ project.name }} AS {{ project.name }}_dev

ARG UID_NUMBER=1000
ARG GID_NUMBER=1000
ARG SSH_PORT=2000
ARG CONAN_LOGIN_USERNAME=""
ARG CONAN_PASSWORD=""
ARG DEV_USER=ubuntu

ENV CONAN_LOGIN_USERNAME=${CONAN_LOGIN_USERNAME}
ENV CONAN_PASSWORD=${CONAN_PASSWORD}

WORKDIR /opt

# configure ssh
RUN apt update --fix-missing && apt install -y --no-install-recommends openssh-server && \
    rm -rf /var/lib/apt/lists/* && \
    ssh-keygen -A && mkdir -p /run/sshd && \
    echo "Port $SSH_PORT" >> /etc/ssh/sshd_config

EXPOSE $SSH_PORT

RUN printf "\n\nCONFIGURING USER $DEV_USER - DEV ENV ONLY!\n\n" >&2 && \
    apt -y install sudo && \
    if ! getent group "$GID_NUMBER" >/dev/null; then \
        if getent group "$DEV_USER" >/dev/null; then \
            groupmod -g "$GID_NUMBER" "$DEV_USER"; \
        else \
            groupadd -g "$GID_NUMBER" "$DEV_USER"; \
        fi; \
    fi && \
    if ! id -u "$DEV_USER" >/dev/null 2>&1; then \
        useradd -m -s /bin/bash -N -o -u "$UID_NUMBER" -g "$GID_NUMBER" "$DEV_USER"; \
    else \
        usermod -o -u "$UID_NUMBER" -g "$GID_NUMBER" "$DEV_USER"; \
    fi && \
    mkdir -p /etc/sudoers.d && \
    echo "$DEV_USER ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/90-$DEV_USER" && \
    chmod 0440 "/etc/sudoers.d/90-$DEV_USER" && \
    passwd -d "$DEV_USER" || true
{% for group_id in supplementary_group_ids %}
RUN if ! getent group "{{ group_id }}" >/dev/null; then \
        groupadd -g "{{ group_id }}" "hostgrp_{{ group_id }}"; \
    fi
{% endfor %}

COPY requirements.txt requirements.txt
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip && \
    /opt/venv/bin/pip install -r requirements.txt && \
    rm requirements.txt
ENV PATH="/opt/venv/bin:${PATH}"

COPY pwrforge-*-py3-none-any.whl /opt/pwrforge-0-py3-none-any.whl
RUN /opt/venv/bin/pip install /opt/pwrforge-0-py3-none-any.whl

RUN usermod -a -G dialout ${DEV_USER}
{% if project.is_stm32() %}
RUN install -d -m 0775 {{ stm32_cube_image_cache_dir }} && \
    if [ ! -d "{{ stm32_cube_image_cache_dir }}/stm32cube{{ stm32_cube_family|lower }}-src/.git" ]; then \
        git clone --depth 1 --recurse-submodules --shallow-submodules \
            https://github.com/STMicroelectronics/STM32Cube{{ stm32_cube_family }}.git \
            {{ stm32_cube_image_cache_dir }}/stm32cube{{ stm32_cube_family|lower }}-src; \
    fi && \
    install -d -m 0775 {{ stm32_cube_cache_dir }} && \
    chown -R ${DEV_USER}:$GID_NUMBER {{ stm32_cube_cache_dir }} {{ stm32_cube_image_cache_dir }}
{% endif %}
ENV HOME=/home/${DEV_USER}
USER ${DEV_USER}
{% if project.is_esp32() %}
RUN /bin/bash -c "echo 'source $IDF_PATH/export.sh'" >> ~/.bashrc
CMD ["/bin/bash"]
{% endif %}
WORKDIR /workspace
